{
  "name": "static-chafa",
  "version": "1.0.0",
  "description": "Zero-dependency terminal image rendering — static & animated images to ANSI art",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "build:native": "scripts/build-platforms.sh native",
    "build:all": "scripts/build-platforms.sh all"
  },
  "optionalDependencies": {
    "@static-chafa/linux-x64": "1.0.0",
    "@static-chafa/linux-arm64": "1.0.0",
    "@static-chafa/darwin-arm64": "1.0.0",
    "@static-chafa/win32-x64": "1.0.0"
  },
  "keywords": ["chafa", "ansi", "terminal", "image", "gif", "webp"],
  "files": ["dist/", "README.md"]
}
