prefix=/home/dev/repos/chafa-ts-multirt/deps/x86_64-linux
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include/libpng16

Name: libpng
Description: Loads and saves PNG files
Version: 1.6.43
Requires.private: zlib
Libs: -L${libdir} -lpng16
Libs.private: -lm -lz 
Cflags: -I${includedir}
