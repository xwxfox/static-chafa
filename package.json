{
  "name": "static-chafa",
  "version": "1.0.1",
  "description": "Zero-dependency terminal image rendering - static & animated images to ANSI art",
  "license": "MIT",
  "type": "module",
  "private": false,
  "workspaces": [
    "platforms/linux-x64",
    "platforms/linux-arm64",
    "platforms/darwin-arm64",
    "platforms/win32-x64"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "build:dev": "./build.sh dev",
    "build:napi": "./build.sh napi",
    "build:node": "./build.sh napi",
    "build:platforms": "./scripts/build-platforms.sh",
    "bump": "./scripts/bump.sh",
    "playground": "bun run playground/index.ts"
  },
  "optionalDependencies": {
    "@static-chafa/linux-x64": "1.0.1",
    "@static-chafa/linux-arm64": "1.0.1",
    "@static-chafa/darwin-arm64": "1.0.1",
    "@static-chafa/win32-x64": "1.0.1"
  },
  "files": [
    "dist/"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "tsdown": "^0.22.14"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "keywords": [
    "chafa",
    "ansi",
    "terminal",
    "image",
    "gif",
    "webp"
  ]
}
